<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    The report assets live next to the reports that use them, and are shared with the MAUI sample,
    the console sample and the design-time preview - so they are linked here rather than copied.
    Unlike MauiAsset, AvaloniaResource has no LogicalName: its avares:// path is the item's Link
    (or, without one, its path relative to the project). The Link below is therefore set to the
    exact relative path the reports ask for - "Fonts/...", "Images/...", "Styles/..." - which is
    what AvaloniaAssetFileSystem resolves against at render time.
  -->
  <ItemGroup>
    <AvaloniaResource Include="..\Pysar.Sample.Reports\Fonts\**"
                       Link="Fonts\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Pysar.Sample.Reports\Images\**"
                       Link="Images\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Pysar.Sample.Reports\Styles\**"
                       Link="Styles\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Avalonia 12: Diagnostics moved to AvaloniaUI.DiagnosticsSupport. Exclude from Release output. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <!--
      Pinned ahead of what Avalonia's Linux support pulls in transitively: 0.21.2 carries a known
      high severity advisory (NU1903, GHSA-xrw6-gwf8-vvr9). It is unused on macOS and Windows, but a
      vulnerable package in the restore graph is noise on every build.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pysar.Sample.Reports\Pysar.Sample.Reports.csproj" />
    <ProjectReference Include="..\..\..\Pysar\src\Pysar.Avalonia\Pysar.Avalonia.csproj" />
  </ItemGroup>
</Project>
