<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Pysar.Maui.Sample</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<!--
			On Mac Catalyst the .app bundle is named after ApplicationTitle, and the IDE launches the
			bundle named after the project. Keeping them equal is what makes Run work from Rider.
		-->
		<ApplicationTitle>Pysar.Maui.Sample</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.mriyalab.pysar.maui.sample</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
		          Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\ios_appiconfg.svg"/>
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
		          Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\android_appiconfg.svg"/>

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#EEEEEE" BaseSize="128,128"/>

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!--
		The report assets live next to the reports that use them, and are shared with the console
		sample and the design-time preview - so they are linked here rather than copied. They travel
		as raw assets under the exact relative paths the reports ask for, which is what
		Pysar.Maui resolves them by at render time.

		MauiFont and MauiImage are deliberately not used: MauiImage rasterises an SVG and files it
		under the platform's image resources (res/drawable-* on Android), out of reach of the
		application package, and the reports draw logo.svg as vector content themselves.

		Link only decides where the files appear in the IDE - Resources/Raw, where MAUI keeps raw
		assets. LogicalName alone decides the path inside the package.
	-->
	<ItemGroup>
		<MauiAsset Include="..\Pysar.Sample.Reports\Fonts\**"
		           Link="Resources\Raw\Fonts\%(Filename)%(Extension)"
		           LogicalName="Fonts/%(Filename)%(Extension)" />
		<MauiAsset Include="..\Pysar.Sample.Reports\Images\**"
		           Link="Resources\Raw\Images\%(Filename)%(Extension)"
		           LogicalName="Images/%(Filename)%(Extension)" />
		<!--
			The reports merge these dictionaries by relative path at load time. Compiled reports carry
			the absolute directory they were built from, which a sandboxed application cannot read, so
			the dictionaries travel in the package under the paths the reports ask for.
		-->
		<MauiAsset Include="..\Pysar.Sample.Reports\Styles\**"
		           Link="Resources\Raw\Styles\%(Filename)%(Extension)"
		           LogicalName="Styles/%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<!-- Keep native libSkiaSharp in lockstep with managed SkiaSharp 4.151.1. -->
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('maccatalyst'))">
		<PackageReference Include="SkiaSharp.NativeAssets.MacCatalyst" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
		<PackageReference Include="SkiaSharp.NativeAssets.iOS" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('android'))">
		<PackageReference Include="SkiaSharp.NativeAssets.Android" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pysar.Sample.Reports\Pysar.Sample.Reports.csproj" />
		<ProjectReference Include="..\..\..\Pysar\src\Pysar.Maui\Pysar.Maui.csproj" />
	</ItemGroup>

</Project>
