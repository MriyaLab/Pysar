<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Pysar.Avalonia</RootNamespace>

        <IsPackable>true</IsPackable>
        <PackageId>Pysar.Avalonia</PackageId>
        <Description>Avalonia integration for Pysar: application asset access, font registration and a scrollable, zoomable report view.</Description>
        <PackageTags>avalonia;report;pdf;skiasharp;pysar</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pysar.Viewer\Pysar.Viewer.csproj" />
    </ItemGroup>

</Project>
