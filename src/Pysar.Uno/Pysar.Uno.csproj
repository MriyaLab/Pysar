<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Pysar.Uno</RootNamespace>

        <IsPackable>true</IsPackable>
        <PackageId>Pysar.Uno</PackageId>
        <Description>Uno Platform integration for Pysar: application asset access, font registration, a scrollable, zoomable report view and PDF printing.</Description>
        <PackageTags>uno;unoplatform;winui;report;pdf;skiasharp;pysar</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Uno.WinUI" />
    </ItemGroup>

    <!--
      UnoRegistration and BrowserWheelZoom are internal, and the tests reach both only through
      this - see UnoRegistration's remarks for why the public surface itself cannot be exercised
      end to end from a test.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="Pysar.Uno.Tests" />
    </ItemGroup>

    <!--
      Embedded rather than a static web asset: those need the Razor SDK, and BrowserWheelZoom inlines
      the script into a data URL anyway, so a browser head needs no file of its own.
    -->
    <ItemGroup>
        <EmbeddedResource Include="Scripts\reportViewZoom.js" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pysar.Viewer\Pysar.Viewer.csproj" />
        <ProjectReference Include="..\Pysar\Pysar.csproj" />
    </ItemGroup>

</Project>
