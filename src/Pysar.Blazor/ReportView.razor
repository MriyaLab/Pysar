@namespace Pysar.Blazor
@inject IJSRuntime Js
@inject IServiceProvider Services

@* contain:inline-size and min-width:0 keep the document off the page's own width. Without them a
   zoom past the frame widens the scroller itself - a flex ancestor's min-width:auto is its content's
   width, so a wide document pushes every container out instead of scrolling inside this one.

   scrollbar-gutter:stable holds the width a fit zoom is measured against. A classic scrollbar
   appearing takes its width out of the client area after the fit has been worked out, and the page
   is then re-fitted a frame later - which is the whole document stepping smaller in front of the
   reader. Where scrollbars overlay (macOS by default) this changes nothing, there being no width
   to lose. *@
<div @ref="_scroller" class="qreport-scroller"
     style="overflow:auto;width:100%;height:100%;position:relative;min-width:0;
            contain:inline-size;scrollbar-gutter:stable">
    <div class="qreport-document"
         style="position:relative;width:@Px(_extentWidth);height:@Px(_extentHeight)">

        @foreach (var (index, bounds) in _pages)
        {
            <div @key="@("page-" + index)"
                 class="qreport-page"
                 style="position:absolute;left:@Px(bounds.X);top:@Px(bounds.Y);
                        width:@Px(bounds.Width);height:@Px(bounds.Height);
                        border:@Px(PageBorderThickness) solid @PageBorderColor;
                        background:#FFFFFF;box-sizing:border-box;overflow:hidden">
                @if (BaseLayerUrl(index) is { } baseUrl)
                {
                    <img src="@baseUrl"
                         alt=""
                         draggable="false"
                         style="width:100%;height:100%;display:block;object-fit:fill;pointer-events:none" />
                }
            </div>
        }

        @foreach (var (key, placed) in _tiles)
        {
            @* Faded in over the layer below rather than swapped for it. The two now describe the
               same page to the pixel, so what changes across the swap is sharpness alone - and a
               step change in sharpness is what the eye reads as the text moving. Over a few frames
               it reads as the page coming into focus. Costs nothing: the compositor does it. *@
            <canvas @key="key"
                    id="@CanvasId(key)"
                    width="@placed.Tile.PixelWidth"
                    height="@placed.Tile.PixelHeight"
                    style="position:absolute;left:@Px(placed.Bounds.X);top:@Px(placed.Bounds.Y);
                           width:@Px(placed.Bounds.Width);height:@Px(placed.Bounds.Height);
                           z-index:@TileZIndex(key);opacity:0;
                           transition:opacity @Ms(TileFade) linear"></canvas>
        }
    </div>
</div>
