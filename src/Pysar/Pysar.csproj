<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <PackageId>Pysar</PackageId>
        <Description>Pysar: the report element tree, data binding, and the SkiaSharp layout, rendering and PDF export engine. Add Pysar.Xaml for declarative report markup and Pysar.&lt;Platform&gt; for a UI viewer.</Description>
        <PackageTags>report;pysar;pdf;skiasharp;rendering;databinding</PackageTags>
    </PropertyGroup>

    <!--
      Layers live in folders, not projects: Core -> Binding -> Elements -> Export -> Skia.
      The compiler no longer enforces that direction; Pysar.Architecture.Tests does,
      by parsing each layer's source and failing if it references a layer to its right.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="Pysar.Xaml" />
        <InternalsVisibleTo Include="Pysar.Elements.Tests" />
        <InternalsVisibleTo Include="Pysar.Export.Tests" />
        <InternalsVisibleTo Include="Pysar.Skia.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="Svg.Skia" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

</Project>
