<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!--
       The design-time preview host is published into this project's output directory and loads
       the reports from there. A library does not copy its NuGet dependencies to bin by default,
       so SkiaSharp and friends would be missing at that point.
     -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <None Update="Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Images\**\*" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Styles\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\..\src\Pysar.Xaml\Pysar.Xaml.csproj" />
      <ProjectReference Include="..\..\src\Pysar\Pysar.csproj" />
      <!-- Generator must be an Analyzer, not a normal assembly reference, or InitializeComponent is never emitted. -->
      <ProjectReference Include="..\..\src\Pysar.Xaml.SourceGen\Pysar.Xaml.SourceGen.csproj"
                        OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    
    <ItemGroup>
      <AdditionalFiles Remove="Reports\Data\Invoice.rxaml" />
      <AdditionalFiles Remove="Reports\Styles\Styles\Colors.rxaml" />
      <AdditionalFiles Remove="Reports\Styles\Styles\Styles.rxaml" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="Reports\Base\BusinessReportXaml.rxaml.cs">
        <DependentUpon>BusinessReportWithStyleXaml.rxaml</DependentUpon>
      </Compile>
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Reports\CustomControls\" />
    </ItemGroup>
    
</Project>
