<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    A real font file is required: SKTypeface.FromStream returns null for anything it cannot decode,
    so the success path cannot be exercised with synthetic bytes. The shared test asset under
    tests/Assets is linked rather than duplicated per test project.
  -->
  <ItemGroup>
    <Content Include="..\Assets\Fonts\Ubuntu-Regular.ttf"
             Link="Fonts\Ubuntu-Regular.ttf"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Two fixtures for EmbeddedAssetFileSystem. The first shares its path with the Content copy above,
    so the chain test can prove disk wins over embedded; the second exists only as a manifest
    resource, which is the embedded-only hit. The attribute is what the .targets emit for a real
    consumer - declared by hand here because this project does not use ReportAsset.

    The second entry is rooted through $(MSBuildThisFileDirectory) rather than written the same way
    as the first: CheckForDuplicateItems compares the literal Include text of every EmbeddedResource,
    not the file it resolves to, so two entries with an identical relative path collide with NETSDK1022
    even though their LogicalName differs. Rooting one of them is the least surprising way to give the
    same physical file two distinct manifest resource entries.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Assets\Fonts\Ubuntu-Regular.ttf" LogicalName="Fonts/Ubuntu-Regular.ttf" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\Assets\Fonts\Ubuntu-Regular.ttf" LogicalName="Fonts/Embedded-Ubuntu.ttf" />
    <AssemblyAttribute Include="Pysar.Core.Abstractions.PysarAssetSourceAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pysar\Pysar.csproj" />
    <ProjectReference Include="..\..\src\Pysar.Xaml\Pysar.Xaml.csproj" />
  </ItemGroup>
</Project>
