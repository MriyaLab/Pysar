<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!--
          The design-time preview host is published into this project's output directory and loads
          the reports from there. A library does not copy its NuGet dependencies to bin by default,
          so SkiaSharp and friends would be missing at that point.
        -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- Relative asset paths in reports (Fonts/..., Images/...) resolve against the app output directory. -->
    <ItemGroup>
        <None Update="Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Images\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="palmy.pysar" Version="0.0.19" />
      <PackageReference Include="palmy.pysar.xaml" Version="0.0.19" />
    </ItemGroup>

</Project>
